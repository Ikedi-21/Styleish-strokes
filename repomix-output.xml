import React, { useState, useEffect } from 'react';
import { motion, AnimatePresence } from 'framer-motion';
import { Menu, X } from 'lucide-react';

export default function Navbar({ activeSection }) {
  const [isOpen, setIsOpen] = useState(false);
  const [visitorCount, setVisitorCount] = useState(3842);

  useEffect(() => {
    const internalClock = setInterval(() => {
      setVisitorCount(prev => prev + Math.floor(Math.random() * 2) + 1);
    }, 5000);
    return () => clearInterval(internalClock);
  }, []);

  const links = [
    { name: 'Home', target: '#hero', id: 'hero' },
    { name: 'About Script', target: '#about', id: 'about' },
    { name: 'Ink Lab', target: '#lab', id: 'lab' },
    { name: 'Learning Resources', target: '#resources', id: 'resources' },
    { name: 'Gallery', target: '#gallery', id: 'gallery' },
    { name: 'Our Team', target: '#team', id: 'team' },
    { name: 'Contact Us', target: '#contact', id: 'contact' }
  ];

  const handleNavClick = (e, target) => {
    e.preventDefault();
    setIsOpen(false);
    const element = document.querySelector(target);
    if (element) {
      element.scrollIntoView({ behavior: 'smooth' });
    }
  };

  return (
    <>
      <nav className="fixed top-0 left-0 w-full z-50 bg-[#000000]/90 backdrop-blur-md border-b border-white/10 h-20 flex items-center justify-between px-8 md:px-16">
        <a href="#hero" onClick={(e) => handleNavClick(e, '#hero')} className="text-xl font-serif tracking-widest uppercase text-white">
          Stylish<span className="italic text-neutral-400">Strokes</span>
        </a>

        {/* Desktop Interface */}
        <div className="hidden lg:flex items-center space-x-6 xl:space-x-8">
          {links.map((link) => (
            <a
              key={link.id}
              href={link.target}
              onClick={(e) => handleNavClick(e, link.target)}
              className={`font-mono text-xs tracking-wider transition-all duration-300 uppercase ${
                activeSection === link.id ? 'text-white border-b border-white pb-1 font-bold' : 'text-neutral-400 hover:text-white'
              }`}
            >
              {link.name}
            </a>
          ))}
          <div className="border-l border-white/20 pl-6 font-mono text-[11px] text-neutral-400 tracking-wider uppercase">
            VISITORS: <span className="text-white font-bold tabular-nums">{visitorCount}</span>
          </div>
        </div>

        {/* Mobile Control Activation */}
        <button onClick={() => setIsOpen(!isOpen)} className="lg:hidden text-white transition-colors hover:text-neutral-300">
          {isOpen ? <X size={22} /> : <Menu size={22} />}
        </button>
      </nav>

      {/* Fluid Mobile Slide & Fade Matrix Overlay */}
      <AnimatePresence>
        {isOpen && (
          <motion.div
            initial={{ opacity: 0, y: -20 }}
            animate={{ opacity: 1, y: 0 }}
            exit={{ opacity: 0, y: -20 }}
            transition={{ duration: 0.4, ease: [0.25, 1, 0.5, 1] }}
            className="fixed inset-0 z-40 bg-[#000000] pt-28 px-8 flex flex-col justify-between pb-16 lg:hidden"
          >
            <div className="flex flex-col space-y-6">
              {links.map((link) => (
                <a
                  key={link.id}
                  href={link.target}
                  onClick={(e) => handleNavClick(e, link.target)}
                  className={`font-serif text-3xl tracking-tight ${
                    activeSection === link.id ? 'text-white italic pl-2 border-l border-white' : 'text-neutral-500'
                  } transition-all`}
                >
                  {link.name}
                </a>
              ))}
            </div>
            <div className="font-mono text-xs text-neutral-500 border-t border-white/10 pt-6 uppercase">
              LIVE PORTAL INDEX OVERSEE: <span className="text-white tracking-widest">{visitorCount}</span>
            </div>
          </motion.div>
        )}
      </AnimatePresence>
    </>
  );
}
