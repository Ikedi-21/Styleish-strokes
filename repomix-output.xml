                      className="w-full flex items-center justify-between border border-neutral-700 hover:border-white px-4 py-3 font-mono text-xs tracking-wider uppercase transition-colors duration-300 text-neutral-300 hover:text-white"
                    >
                      <span>{activeDownloadId === sheet.id ? 'Extracting File...' : 'Download Practice Grid'}</span>
                      <ArrowDownToLine size={13} />
                    </button>
                  </div>
                </motion.div>
              ))}
            </AnimatePresence>
          </motion.div>
        </div>

        {/* Live Tracing Customizer Module */}
        <div className="border border-neutral-800 p-8 bg-[#050505] rounded-none">
          <div className="flex flex-col lg:flex-row justify-between items-start lg:items-center border-b border-neutral-800 pb-6 mb-8 gap-6">
            <div>
              <span className="font-mono text-xs tracking-widest text-neutral-500 block mb-1 flex items-center gap-2">
                <Sparkles size={12} className="text-[#D4AF37]" /> // WORKSPACE
              </span>
              <h3 className="text-2xl md:text-3xl font-serif font-light tracking-tight uppercase">LIVE TRACING BLUEPRINT CREATOR</h3>
            </div>

            {/* Customizer controls */}
            <div className="flex flex-wrap items-center gap-4">
              <div className="flex border border-neutral-800 p-1 bg-black">
                <button 
                  onClick={() => setFontPreset('SERIF_ITALIC')} 
                  className={`px-3 py-1.5 font-mono text-[9px] tracking-wider font-bold ${fontPreset === 'SERIF_ITALIC' ? 'bg-white text-black' : 'text-white'}`}
                >
                  WESTERN ITALIC
                </button>
                <button 
                  onClick={() => setFontPreset('SANS_CAPS')} 
                  className={`px-3 py-1.5 font-mono text-[9px] tracking-wider font-bold ${fontPreset === 'SANS_CAPS' ? 'bg-white text-black' : 'text-white'}`}
                >
                  MODERN CAPITALS
                </button>
              </div>

              <button 
                onClick={() => setShowGuides(!showGuides)}
                className={`px-4 py-2 border font-mono text-[9px] tracking-wider uppercase transition-all ${
                  showGuides ? 'bg-white/5 border-neutral-700 text-white' : 'border-neutral-800 text-neutral-500'
                }`}
              >
                {showGuides ? 'GUIDES: ON' : 'GUIDES: OFF'}
